###  https://arden.ag/ont/bridge#CornAsset
<https://arden.ag/ont/bridge#CornAsset> rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( <https://arden.ag/ont/bridge#CommodityAsset>
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty <https://arden.ag/ont/bridge#representsCommodity> ;
                                                                                     owl:hasValue <https://arden.ag/ont/ag#MaizeCrop>
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf <https://arden.ag/ont/bridge#CommodityAsset> ,
                                                        <https://arden.ag/ont/bridge#SecuritizationEligible> ;
                                        rdfs:label "Corn Asset"@en .


###  https://arden.ag/ont/bridge#CropMassQuantityKind
