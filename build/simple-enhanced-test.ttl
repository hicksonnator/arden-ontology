@prefix : <https://arden.ag/ont/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix arden: <https://arden.ag/ont/core#> .
@base <https://arden.ag/ont/core> .

<https://arden.ag/ont/core> rdf:type owl:Ontology ;
                             rdfs:comment "Core entities and relations across ag/finance/geo."@en ;
                             rdfs:label "Arden Core"@en ;
                             owl:versionInfo "v1.1" .

#################################################################
#    Object Properties
#################################################################

###  http://qudt.org/schema/qudt/hasQuantityKind
<http://qudt.org/schema/qudt/hasQuantityKind> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/hasUnit
<http://qudt.org/schema/qudt/hasUnit> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty .


###  https://arden.ag/ont/bridge#cropYieldOf
<https://arden.ag/ont/bridge#cropYieldOf> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://qudt.org/schema/qudt/QuantityValue> ;
                                          rdfs:range <https://arden.ag/ont/ag#ProductionSystem> ;
                                          rdfs:label "crop yield of"@en .


###  https://arden.ag/ont/bridge#drivesCashFlow
<https://arden.ag/ont/bridge#drivesCashFlow> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://qudt.org/schema/qudt/QuantityValue> ;
                                             rdfs:range <https://arden.ag/ont/fin#CashFlowAssumption> ;
                                             owl:propertyChainAxiom ( <https://arden.ag/ont/bridge#cropYieldOf>
                                                                      <https://arden.ag/ont/bridge#usedInPlan>
                                                                    ) ;
                                             rdfs:comment "Links a measured quantity to cash flow assumptions in financial planning"@en ;
                                             rdfs:label "drives cash flow"@en .


###  https://arden.ag/ont/bridge#hasEvidence
<https://arden.ag/ont/bridge#hasEvidence> rdf:type owl:ObjectProperty ;
                                          rdfs:range <https://arden.ag/ont/bridge#Evidence> ;
                                          rdfs:comment "Links a bridge assertion to supporting evidence"@en ;
                                          rdfs:label "has evidence"@en .


###  https://arden.ag/ont/bridge#hasMarketPrice
<https://arden.ag/ont/bridge#hasMarketPrice> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://arden.ag/ont/bridge#CommodityAsset> ;
                                             rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                                             rdfs:label "has market price"@en .


###  https://arden.ag/ont/bridge#hasReferenceCommodity
<https://arden.ag/ont/bridge#hasReferenceCommodity> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://arden.ag/ont/bridge#FuturesContract> ;
                                                    rdfs:range <https://arden.ag/ont/ag#Crop> ;
                                                    rdfs:label "has reference commodity"@en .


###  https://arden.ag/ont/bridge#influencedByFutures
<https://arden.ag/ont/bridge#influencedByFutures> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://arden.ag/ont/fin#ValuationAdjustment> ;
                                                  rdfs:range <https://arden.ag/ont/bridge#FuturesContract> ;
                                                  rdfs:comment "Links collateral value to futures market trends"@en ;
                                                  rdfs:label "influenced by futures"@en .


###  https://arden.ag/ont/bridge#mapsToRiskFactor
<https://arden.ag/ont/bridge#mapsToRiskFactor> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://arden.ag/ont/ag#AgRiskFactor> ;
                                               rdfs:range <https://arden.ag/ont/fin#CollateralRiskFactor> ;
                                               rdfs:comment "Maps agricultural risk factors to financial collateral risk factors"@en ;
                                               rdfs:label "maps to risk factor"@en .


###  https://arden.ag/ont/bridge#normalizedTo
<https://arden.ag/ont/bridge#normalizedTo> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://qudt.org/schema/qudt/QuantityValue> ;
                                           rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                                           rdfs:comment "Links a quantity value to its normalized equivalent in standard units"@en ;
                                           rdfs:label "normalized to"@en .


###  https://arden.ag/ont/bridge#representsCommodity
<https://arden.ag/ont/bridge#representsCommodity> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://arden.ag/ont/bridge#CommodityAsset> ;
                                                  rdfs:range <https://arden.ag/ont/ag#Crop> ;
                                                  rdfs:comment "Links a financial asset to the agricultural commodity it represents"@en ;
                                                  rdfs:label "represents commodity"@en .


###  https://arden.ag/ont/bridge#usedInPlan
<https://arden.ag/ont/bridge#usedInPlan> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://arden.ag/ont/ag#ProductionSystem> ;
                                         rdfs:range <https://arden.ag/ont/fin#UnderwritingPlan> ;
                                         rdfs:label "used in plan"@en .


###  https://arden.ag/ont/bridge#valuationAdjustment
<https://arden.ag/ont/bridge#valuationAdjustment> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://arden.ag/ont/fin#Collateral> ;
                                                  rdfs:range <https://arden.ag/ont/fin#ValuationAdjustment> ;
                                                  rdfs:label "valuation adjustment"@en .


###  https://arden.ag/ont/core#hasLoan
arden:hasLoan rdf:type owl:ObjectProperty ;
              rdfs:domain arden:FarmOperation ;
              rdfs:label "has loan"@en .


###  https://arden.ag/ont/core#hasParcel
arden:hasParcel rdf:type owl:ObjectProperty ;
                rdfs:domain arden:FarmOperation ;
                rdfs:range arden:FarmParcel ;
                rdfs:label "has parcel"@en .


###  https://arden.ag/ont/core#locatedInCounty
arden:locatedInCounty rdf:type owl:ObjectProperty ;
                      rdfs:domain arden:FarmParcel ;
                      rdfs:label "located in county"@en .


###  https://arden.ag/ont/fin#wasGeneratedByModel
<https://arden.ag/ont/fin#wasGeneratedByModel> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf prov:wasGeneratedBy ;
                                               rdfs:domain <https://arden.ag/ont/fin#ModeledEstimate> ;
                                               rdfs:range <https://arden.ag/ont/fin#EstimationModel> ;
                                               rdfs:label "was generated by model"@en .


