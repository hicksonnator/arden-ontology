<?xml version="1.0"?>
<rdf:RDF xmlns="https://arden.ag/ont/core#"
     xml:base="https://arden.ag/ont/core"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:arden="https://arden.ag/ont/core#"
     xmlns:bridge="https://arden.ag/ont/bridge#">
    <owl:Ontology rdf:about="https://arden.ag/ont/core">
        <rdfs:comment xml:lang="en">Core entities and relations across ag/finance/geo.</rdfs:comment>
        <rdfs:label xml:lang="en">Arden Core</rdfs:label>
        <owl:versionInfo>v1.1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/hasQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasQuantityKind"/>
    


    <!-- http://qudt.org/schema/qudt/hasUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit"/>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    


    <!-- https://arden.ag/ont/bridge#cropYieldOf -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#cropYieldOf">
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/ag#ProductionSystem"/>
        <rdfs:label xml:lang="en">crop yield of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#drivesCashFlow -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#drivesCashFlow">
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/fin#CashFlowAssumption"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://arden.ag/ont/bridge#cropYieldOf"/>
            <rdf:Description rdf:about="https://arden.ag/ont/bridge#usedInPlan"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">Links a measured quantity to cash flow assumptions in financial planning</rdfs:comment>
        <rdfs:label xml:lang="en">drives cash flow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#hasEvidence -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#hasEvidence">
        <rdfs:range rdf:resource="https://arden.ag/ont/bridge#Evidence"/>
        <rdfs:comment xml:lang="en">Links a bridge assertion to supporting evidence</rdfs:comment>
        <rdfs:label xml:lang="en">has evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#hasMarketPrice -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#hasMarketPrice">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#CommodityAsset"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:label xml:lang="en">has market price</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#hasReferenceCommodity -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#hasReferenceCommodity">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#FuturesContract"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/ag#Crop"/>
        <rdfs:label xml:lang="en">has reference commodity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#influencedByFutures -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#influencedByFutures">
        <rdfs:domain rdf:resource="https://arden.ag/ont/fin#ValuationAdjustment"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/bridge#FuturesContract"/>
        <rdfs:comment xml:lang="en">Links collateral value to futures market trends</rdfs:comment>
        <rdfs:label xml:lang="en">influenced by futures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#mapsToRiskFactor -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#mapsToRiskFactor">
        <rdfs:domain rdf:resource="https://arden.ag/ont/ag#AgRiskFactor"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/fin#CollateralRiskFactor"/>
        <rdfs:comment xml:lang="en">Maps agricultural risk factors to financial collateral risk factors</rdfs:comment>
        <rdfs:label xml:lang="en">maps to risk factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#normalizedTo -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#normalizedTo">
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Links a quantity value to its normalized equivalent in standard units</rdfs:comment>
        <rdfs:label xml:lang="en">normalized to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#representsCommodity -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#representsCommodity">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#CommodityAsset"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/ag#Crop"/>
        <rdfs:comment xml:lang="en">Links a financial asset to the agricultural commodity it represents</rdfs:comment>
        <rdfs:label xml:lang="en">represents commodity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#usedInPlan -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#usedInPlan">
        <rdfs:domain rdf:resource="https://arden.ag/ont/ag#ProductionSystem"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/fin#UnderwritingPlan"/>
        <rdfs:label xml:lang="en">used in plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/bridge#valuationAdjustment -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/bridge#valuationAdjustment">
        <rdfs:domain rdf:resource="https://arden.ag/ont/fin#Collateral"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/fin#ValuationAdjustment"/>
        <rdfs:label xml:lang="en">valuation adjustment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/core#hasLoan -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/core#hasLoan">
        <rdfs:domain rdf:resource="https://arden.ag/ont/core#FarmOperation"/>
        <rdfs:label xml:lang="en">has loan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/core#hasParcel -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/core#hasParcel">
        <rdfs:domain rdf:resource="https://arden.ag/ont/core#FarmOperation"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/core#FarmParcel"/>
        <rdfs:label xml:lang="en">has parcel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/core#locatedInCounty -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/core#locatedInCounty">
        <rdfs:domain rdf:resource="https://arden.ag/ont/core#FarmParcel"/>
        <rdfs:label xml:lang="en">located in county</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://arden.ag/ont/fin#wasGeneratedByModel -->

    <owl:ObjectProperty rdf:about="https://arden.ag/ont/fin#wasGeneratedByModel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <rdfs:domain rdf:resource="https://arden.ag/ont/fin#ModeledEstimate"/>
        <rdfs:range rdf:resource="https://arden.ag/ont/fin#EstimationModel"/>
        <rdfs:label xml:lang="en">was generated by model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://arden.ag/ont/bridge#competencyQuestion -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#competencyQuestion">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#BridgeMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Competency question that this mapping supports</rdfs:comment>
        <rdfs:label xml:lang="en">competency question</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/bridge#confidence -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#confidence">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#BridgeMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Confidence score for bridge mapping (0.0-1.0)</rdfs:comment>
        <rdfs:label xml:lang="en">confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/bridge#mappingType -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#mappingType">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#BridgeMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">mapping type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/core#sourceSystemId -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/core#sourceSystemId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">External primary key for lineage/provenance joins.</rdfs:comment>
        <rdfs:label xml:lang="en">source system identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/QuantityKind -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityKind">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Observation -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#AgRiskFactor -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#AgRiskFactor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#Crop -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#Crop">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#InputUseObservation -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#InputUseObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Application of input (fertilizer, pesticide, seed treatment) with rate/AI.</rdfs:comment>
        <rdfs:label xml:lang="en">Input use observation</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#ProductionSystem -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#ProductionSystem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#YieldObservation -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#YieldObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Yield of a crop at a parcel/time.</rdfs:comment>
        <rdfs:label xml:lang="en">Yield observation</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#AreaQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#AreaQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:label xml:lang="en">Area Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#BridgeMapping -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#BridgeMapping">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A semantic mapping between agricultural and financial concepts</rdfs:comment>
        <rdfs:label xml:lang="en">Bridge Mapping</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#BushelPerAcreValue -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#BushelPerAcreValue">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
                <owl:hasValue rdf:resource="https://arden.ag/ont/bridge#YieldQuantityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
                <owl:hasValue rdf:resource="http://qudt.org/vocab/unit/BushelPerAcre"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CommodityAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CommodityAsset">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/fin#Asset"/>
        <rdfs:comment xml:lang="en">Financial asset representing an agricultural commodity</rdfs:comment>
        <rdfs:label xml:lang="en">Commodity Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CompetencyQuestionEvidence -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CompetencyQuestionEvidence">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#Evidence"/>
        <rdfs:comment xml:lang="en">Evidence derived from competency question requirements</rdfs:comment>
        <rdfs:label xml:lang="en">Competency Question Evidence</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CornAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CornAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://arden.ag/ont/bridge#CommodityAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://arden.ag/ont/bridge#representsCommodity"/>
                        <owl:hasValue rdf:resource="https://arden.ag/ont/ag#MaizeCrop"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#SecuritizationEligible"/>
        <rdfs:label xml:lang="en">Corn Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#DroughtRisk -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#DroughtRisk">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/ag#AgRiskFactor"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#Evidence -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#Evidence">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Supporting evidence for bridge mappings and inferences</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#FuturesContract -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#FuturesContract">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/fin#DerivativeContract"/>
        <rdfs:label xml:lang="en">Futures Contract</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#LandValueRisk -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#LandValueRisk">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/fin#CollateralRiskFactor"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#MarketDataEvidence -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#MarketDataEvidence">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#Evidence"/>
        <rdfs:comment xml:lang="en">Evidence from agricultural and financial market data</rdfs:comment>
        <rdfs:label xml:lang="en">Market Data Evidence</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#ProductionRisk -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#ProductionRisk">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/fin#CollateralRiskFactor"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#SecuritizationEligible -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#SecuritizationEligible">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#CommodityAsset"/>
        <rdfs:label xml:lang="en">Securitization Eligible</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#SoilErosionRisk -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#SoilErosionRisk">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/ag#AgRiskFactor"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#SoybeanAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#SoybeanAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://arden.ag/ont/bridge#CommodityAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://arden.ag/ont/bridge#representsCommodity"/>
                        <owl:hasValue rdf:resource="https://arden.ag/ont/ag#SoybeanCrop"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#SecuritizationEligible"/>
        <rdfs:label xml:lang="en">Soybean Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#TonnePerHectareValue -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#TonnePerHectareValue">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
                <owl:hasValue rdf:resource="https://arden.ag/ont/bridge#YieldQuantityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
                <owl:hasValue rdf:resource="http://qudt.org/vocab/unit/TonnePerHectare"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#WheatAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#WheatAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://arden.ag/ont/bridge#CommodityAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://arden.ag/ont/bridge#representsCommodity"/>
                        <owl:hasValue rdf:resource="https://arden.ag/ont/ag#WheatCrop"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#SecuritizationEligible"/>
        <rdfs:label xml:lang="en">Wheat Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#WheatFuturesContract -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#WheatFuturesContract">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#FuturesContract"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://arden.ag/ont/bridge#hasReferenceCommodity"/>
                <owl:hasValue rdf:resource="https://arden.ag/ont/ag#WheatCrop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#YieldQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#YieldQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/core#FarmOperation -->

    <owl:Class rdf:about="https://arden.ag/ont/core#FarmOperation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A legal/economic entity engaged in agricultural production.</rdfs:comment>
        <rdfs:label xml:lang="en">Farm Operation</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/core#FarmParcel -->

    <owl:Class rdf:about="https://arden.ag/ont/core#FarmParcel">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A spatial unit of cultivation, geometry via GeoSPARQL.</rdfs:comment>
        <rdfs:label xml:lang="en">Farm Parcel</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/core#Farmer -->

    <owl:Class rdf:about="https://arden.ag/ont/core#Farmer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Farmer</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/core#Practice -->

    <owl:Class rdf:about="https://arden.ag/ont/core#Practice">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Agricultural practice</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/fin#AgriculturalLoan -->

    <owl:Class rdf:about="https://arden.ag/ont/fin#AgriculturalLoan">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Loan extended to a farm operation; FIBO aligned in bridge layer.</rdfs:comment>
        <rdfs:label xml:lang="en">Agricultural loan</rdfs:label>
    </owl:Class>
    


