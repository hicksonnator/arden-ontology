    <!-- https://cropontology.org/rdf/CO_336:0000069 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000069">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
        <rdfs:label xml:lang="en">Twining date</rdfs:label>
        <skos:definition xml:lang="en">Time when soybean twines</skos:definition>
        <rdf1:acronym xml:lang="en">TWINNING</rdf1:acronym>
        <rdf1:attribute>Twinning time</rdf1:attribute>
        <rdf1:entity>Plant</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_336:0000070 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000070">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
                <owl:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_336:0000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Twinning date observation</rdfs:label>
        <skos:definition xml:lang="en">Take note of the date when 50% of plants are twining</skos:definition>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_336:0000071 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000071">
