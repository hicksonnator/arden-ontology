        <rdf1:attribute>anthesis silking interval</rdf1:attribute>
        <rdf1:entity>Plant</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000010 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000010">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Grain number</rdfs:label>
        <skos:definition xml:lang="en">Grain number.</skos:definition>
        <rdf1:acronym xml:lang="en">GN</rdf1:acronym>
        <rdf1:attribute>number</rdf1:attribute>
        <rdf1:entity>Grain</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000011 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000011">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Plant aspect</rdfs:label>
        <skos:definition xml:lang="en">Qualitative observation of plant ideotype. In another word, it rates characteristics such as plant and ear height, uniformity of plants, disease and insect damage, and lodging.</skos:definition>
        <rdf1:acronym xml:lang="en">PAsp</rdf1:acronym>
        <rdf1:attribute>aspect</rdf1:attribute>
        <rdf1:entity>Plant</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000012 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000012">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Senescence</rdfs:label>
        <skos:definition xml:lang="en">Leaf senescence.</skos:definition>
        <rdf1:acronym xml:lang="en">Sen</rdf1:acronym>
        <rdf1:attribute>senescence</rdf1:attribute>
        <rdf1:entity>Leaf</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000013 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000013">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
        <rdfs:label xml:lang="en">Silk length</rdfs:label>
        <skos:definition xml:lang="en">Silk length.</skos:definition>
