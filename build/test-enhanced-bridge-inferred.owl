        <rdfs:label xml:lang="en">Ear length</rdfs:label>
        <skos:definition xml:lang="en">Ear length.</skos:definition>
        <rdf1:acronym xml:lang="en">ELng</rdf1:acronym>
        <rdf1:attribute>length</rdf1:attribute>
        <rdf1:entity>Ear</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000016 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000016">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Ear growth rate</rdfs:label>
        <skos:definition xml:lang="en">Growth rate of the ear(s) on a plant. It may include the sum of the apical and sub-apical ear growth from prolific plants.</skos:definition>
        <rdf1:acronym xml:lang="en">EGrwR</rdf1:acronym>
        <rdf1:attribute>growth rate</rdf1:attribute>
        <rdf1:entity>Ear</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000017 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000017">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Ear height</rdfs:label>
        <skos:definition xml:lang="en">Plant height from base to the insertion of the top (uppermost) ear.</skos:definition>
        <rdf1:acronym xml:lang="en">EH</rdf1:acronym>
        <rdf1:attribute>height to insertion of uppermost ear</rdf1:attribute>
        <rdf1:entity>Plant</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000020 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000020">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Ear position</rdfs:label>
        <skos:definition xml:lang="en">Ear position as a ratio of ear height to plant height.</skos:definition>
        <rdf1:acronym xml:lang="en">EPo</rdf1:acronym>
        <rdf1:attribute>position</rdf1:attribute>
        <rdf1:entity>Ear</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_322:0000021 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_322:0000021">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
        <rdfs:label xml:lang="en">Ear number</rdfs:label>
        <skos:definition xml:lang="en">Ear number.</skos:definition>
        <rdf1:acronym xml:lang="en">EN</rdf1:acronym>
