    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#ProductionSystem -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#ProductionSystem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/ag#YieldObservation -->

    <owl:Class rdf:about="https://arden.ag/ont/ag#YieldObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Yield of a crop at a parcel/time.</rdfs:comment>
        <rdfs:label xml:lang="en">Yield observation</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#AcreUnit -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#AcreUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#AgYieldQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#AgYieldQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:symbol>Y_ag</qudt:symbol>
        <rdfs:comment xml:lang="en">Quantity kind for crop yields (mass/area or volume/area)</rdfs:comment>
        <rdfs:label xml:lang="en">Agricultural Yield Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#AreaQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#AreaQuantityKind">
