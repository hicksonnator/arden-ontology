        <rdf1:attribute>Flooding tolerance</rdf1:attribute>
        <rdf1:entity>Plant</rdf1:entity>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_336:0000073 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000073">
