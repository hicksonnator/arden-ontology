        <rdfs:label xml:lang="en">has conversion factor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/bridge#mappingType -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#mappingType">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#BridgeMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">mapping type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/bridge#validationDate -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#validationDate">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#ValidatedConversion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">validation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/bridge#validationSource -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/bridge#validationSource">
        <rdfs:domain rdf:resource="https://arden.ag/ont/bridge#ValidatedConversion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">validation source</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://arden.ag/ont/core#sourceSystemId -->

    <owl:DatatypeProperty rdf:about="https://arden.ag/ont/core#sourceSystemId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">External primary key for lineage/provenance joins.</rdfs:comment>
        <rdfs:label xml:lang="en">source system identifier</rdfs:label>
    </owl:DatatypeProperty>
    


