                <owl:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_336:0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">mmdd</rdfs:label>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_336:0000072 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000072">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Abiotic_stress"/>
        <rdfs:label xml:lang="en">Flooding tolerance</rdfs:label>
