    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CommodityAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CommodityAsset">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/fin#Asset"/>
        <rdfs:comment xml:lang="en">Financial asset representing an agricultural commodity</rdfs:comment>
        <rdfs:label xml:lang="en">Commodity Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CommodityPriceQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CommodityPriceQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:symbol>P_comm</qudt:symbol>
        <rdfs:comment xml:lang="en">Quantity kind for commodity prices (currency/mass or currency/volume)</rdfs:comment>
        <rdfs:label xml:lang="en">Commodity Price Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CompetencyQuestionEvidence -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CompetencyQuestionEvidence">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#Evidence"/>
        <rdfs:comment xml:lang="en">Evidence derived from competency question requirements</rdfs:comment>
        <rdfs:label xml:lang="en">Competency Question Evidence</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CornAsset -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CornAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://arden.ag/ont/bridge#CommodityAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://arden.ag/ont/bridge#representsCommodity"/>
                        <owl:hasValue rdf:resource="https://arden.ag/ont/ag#MaizeCrop"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#SecuritizationEligible"/>
        <rdfs:label xml:lang="en">Corn Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CropMassQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CropMassQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:symbol>M_crop</qudt:symbol>
        <rdfs:comment xml:lang="en">Quantity kind for harvested crop mass</rdfs:comment>
        <rdfs:label xml:lang="en">Crop Mass Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#CropVolumeQuantityKind -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#CropVolumeQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:symbol>V_crop</qudt:symbol>
        <rdfs:comment xml:lang="en">Quantity kind for harvested crop volume (bushels, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">Crop Volume Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#DollarsPerBushelUnit -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#DollarsPerBushelUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#DollarsPerTonneUnit -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#DollarsPerTonneUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasQuantityKind rdf:resource="https://arden.ag/ont/bridge#CommodityPriceQuantityKind"/>
