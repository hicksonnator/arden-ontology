        <qudt:symbol>L_amt</qudt:symbol>
        <rdfs:comment xml:lang="en">Quantity kind for loan principal amounts</rdfs:comment>
        <rdfs:label xml:lang="en">Loan Amount Quantity Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://arden.ag/ont/bridge#MarketDataEvidence -->

    <owl:Class rdf:about="https://arden.ag/ont/bridge#MarketDataEvidence">
        <rdfs:subClassOf rdf:resource="https://arden.ag/ont/bridge#Evidence"/>
        <rdfs:comment xml:lang="en">Evidence from agricultural and financial market data</rdfs:comment>
