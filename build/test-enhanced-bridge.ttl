                                                                 owl:hasValue arden-ag:SoybeanCrop
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ,
                                        [ owl:intersectionOf ( bridge:CommodityAsset
                                                               [ rdf:type owl:Restriction ;
