                                                               owl:someValuesFrom bridge:WheatFuturesContract
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty bridge:representsCommodity ;
                                                               owl:hasValue arden-ag:WheatCrop
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ,
                                      [ owl:intersectionOf ( bridge:CommodityAsset
                                                             [ rdf:type owl:Restriction ;
