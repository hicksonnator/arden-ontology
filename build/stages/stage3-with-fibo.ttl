<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Wednesday> rdf:type owl:NamedIndividual ,
                                                                                                <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> ;
