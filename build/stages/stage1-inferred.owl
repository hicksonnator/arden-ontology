        <rdfs:label>qualifiedUsingActivity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#quotedAs -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#quotedAs">
