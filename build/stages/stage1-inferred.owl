    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedQuotationOf">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o-inverses#"/>
        <rdfs:label>qualifiedQuotationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedRemoval -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedRemoval">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#qualifiedDerivation"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Dictionary"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Removal"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
        <rdfs:label>qualifiedRemoval</rdfs:label>
        <prov:category>collections</prov:category>
        <prov:component>collections</prov:component>
        <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints</prov:constraints>
        <prov:definition>The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed keys.</prov:definition>
        <prov:definition>prov:qualifiedRemoval shows the details of a removal, in particular the removed keys.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal</prov:n>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedRevision -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedRevision">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#qualifiedInfluence"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#revisedEntity"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Revision"/>
        <rdfs:comment xml:lang="en">If this Entity prov:wasRevisionOf Entity :e, then it can qualify how it was revised using prov:qualifiedRevision [ a prov:Revision;  prov:entity :e; :foo :bar ].</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>qualifiedRevision</rdfs:label>
        <prov:category>qualified</prov:category>
        <prov:component>derivations</prov:component>
        <prov:inverse>revisedEntity</prov:inverse>
        <prov:sharesDefinitionWith rdf:resource="http://www.w3.org/ns/prov#Revision"/>
        <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
    </owl:ObjectProperty>
    


