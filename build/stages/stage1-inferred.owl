        <rdfs:label>qualifiedDelegationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedDerivation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedDerivation">
