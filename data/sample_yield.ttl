@prefix : <https://example.org/data#> .
@prefix arden: <https://arden.ag/ont/core#> .
@prefix arden-ag: <https://arden.ag/ont/ag#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:yieldObs1 a arden-ag:YieldObservation ;
  sosa:hasFeatureOfInterest :parcel42 ;
  sosa:resultTime "2023-10-01T00:00:00Z"^^xsd:dateTime ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "185.2"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] .

:yieldObs2 a arden-ag:YieldObservation ;
  sosa:hasFeatureOfInterest :parcel42 ;
  sosa:resultTime "2023-10-15T00:00:00Z"^^xsd:dateTime ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "192.8"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] .

:yieldObs3 a arden-ag:YieldObservation ;
  sosa:hasFeatureOfInterest :parcel42 ;
  sosa:resultTime "2023-10-20T00:00:00Z"^^xsd:dateTime ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "178.5"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] .