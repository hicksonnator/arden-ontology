@prefix : <https://arden.ag/ont/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix arden: <https://arden.ag/ont/core#> .
@base <https://arden.ag/ont/core> .

<https://arden.ag/ont/core> rdf:type owl:Ontology ;
                             rdfs:comment "Core entities and relations across ag/finance/geo."@en ;
                             rdfs:label "Arden Core"@en ;
                             owl:versionInfo "v1.1" .

#################################################################
#    Object Properties
#################################################################

###  https://arden.ag/ont/core#hasLoan
arden:hasLoan rdf:type owl:ObjectProperty ;
              rdfs:domain arden:FarmOperation ;
              rdfs:label "has loan"@en .


###  https://arden.ag/ont/core#hasParcel
arden:hasParcel rdf:type owl:ObjectProperty ;
                rdfs:domain arden:FarmOperation ;
                rdfs:range arden:FarmParcel ;
                rdfs:label "has parcel"@en .


###  https://arden.ag/ont/core#locatedInCounty
arden:locatedInCounty rdf:type owl:ObjectProperty ;
                      rdfs:domain arden:FarmParcel ;
                      rdfs:label "located in county"@en .


#################################################################
#    Data properties
#################################################################

###  https://arden.ag/ont/core#sourceSystemId
arden:sourceSystemId rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:string ;
                     rdfs:comment "External primary key for lineage/provenance joins."@en ;
                     rdfs:label "source system identifier"@en .


#################################################################
#    Classes
#################################################################

###  https://arden.ag/ont/core#FarmOperation
arden:FarmOperation rdf:type owl:Class ;
                    rdfs:comment "A legal/economic entity engaged in agricultural production."@en ;
                    rdfs:label "Farm Operation"@en .


###  https://arden.ag/ont/core#FarmParcel
arden:FarmParcel rdf:type owl:Class ;
                 rdfs:comment "A spatial unit of cultivation, geometry via GeoSPARQL."@en ;
                 rdfs:label "Farm Parcel"@en .


###  https://arden.ag/ont/core#Farmer
arden:Farmer rdf:type owl:Class ;
             rdfs:label "Farmer"@en .


###  https://arden.ag/ont/core#Practice
arden:Practice rdf:type owl:Class ;
               rdfs:label "Agricultural practice"@en .


