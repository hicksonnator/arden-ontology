# Arden Ontology .gitignore

# Large external ontology files (>100MB)
# These should be downloaded on-demand via scripts/fetch_ontologies.sh
externals/ncbitaxon-full.owl
externals/agro-full.owl
externals/fibo-*.rdf

# Temporary extraction files
externals/temp/
externals/subsets/temp/

# Build artifacts
release/*.ttl
release/*.owl
release/*.zip

# Tool outputs
*.log
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python cache
__pycache__/
*.pyc
*.pyo

# Backup files
*~
*.bak
*.backup