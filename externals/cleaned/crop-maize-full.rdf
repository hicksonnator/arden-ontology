  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000795">
    <rdfs:label xml:lang="en">Anthesis date - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Date when 50% of the plants shed pollen. Observe a known number of plants carefully (guideline: N = 20 for inbred lines or hybrids; N = 35 for open pollinated varieties) at the same time each day until 50% of the plants in the plot have produced at least one visible anther and record the date.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N0cbd4fe1397a4f458c0c9812a634a153">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000030"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000211">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">RLodgInc - Computation</rdfs:label>
    <ns1:definition xml:lang="en">Divide the total number of plants that are root lodged due to weak soil or poorly developed anchorage roots by the total number of plants that are harvested.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nef1a903b7ea342b0920a7207dc785cde">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000034"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
