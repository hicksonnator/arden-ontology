        <rdfs:label>has maturity level</rdfs:label>
        <skos:definition>links something to its state with respect to a development lifecycle</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation -->

    <owl:AnnotationProperty rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation">
