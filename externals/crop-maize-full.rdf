  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000235">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nfa2c22f92e1a4645a0b30c9bc447fc85">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000066"/>
      </ns3:Restriction>
