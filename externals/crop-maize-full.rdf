  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000339">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">GWLostWeev - Measurement</rdfs:label>
    <ns1:definition xml:lang="en">Seed weight loss was determined using the count and weight method of Gwinner et al (1996). Weight loss (%) = (Wu x Nd) - (Wd x Nu) x 100 / Wu x (Nd + Nu) where Wu=weight of the undamaged seed, Nu = number of undamaged seed, Wd = Weight of damaged seed, and Nd=Number of damaged seed.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbc283db9065647d49b6910f410b6626c">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000131"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
