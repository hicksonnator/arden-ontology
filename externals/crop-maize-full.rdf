  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000199">
    <rdfs:label xml:lang="en">EAsp - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Harvest ears per plot (eliminate first and last plants to avoid border effects) and score ear aspect combining several ear-associated traits. Note: Combination of traits usually differs from one breeder to another depending on type of study.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N2046ad2452ee49838d09435b1e3871fd">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000018"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000163">
    <ns2:acronym xml:lang="en">ShtPub</ns2:acronym>
    <rdfs:label xml:lang="en">Sheath pubescence</rdfs:label>
    <ns2:entity>Sheath</ns2:entity>
    <ns1:definition xml:lang="en">Presence and intensity of hairs on the surface of the leaf sheath.</ns1:definition>
    <ns2:attribute>pubescence</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000202">
    <rdfs:label xml:lang="en">GProt - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Na5cb9e27f3774a1e9409b4fb70f92e4b">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000122"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Standard method for whole-grain protein content. % Protein = % of nitrogen x 6.25</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000364">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N734305edcbd34c9ab0ed088b3b6ef5be">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000190"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe the aleurone color, when applicable, on at least 20 representative plants per accession.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">AleuCol - Estimation</rdfs:label>
  </ns3:Class>
