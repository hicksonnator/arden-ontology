    <rdfs:label xml:lang="en">EWormDmg - Measurement</rdfs:label>
    <ns1:definition xml:lang="en">Standard method for earworm damage measured in cm of feeding. 0 - no ear damage, 1 - 1 cm, + 1 for each additional cm of feeding</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N3b51b575f8004ce4b71569bf677440b1">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000685"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000549">
    <ns1:definition xml:lang="en">Count the total number of emerged striga plants per plot. It is counted three times, 8 weeks, 10 weeks and 12 weeks after planting.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbf7c13fbcab14e26a937399cb77ef9d1">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000938"/>
