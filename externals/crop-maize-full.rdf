    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">StrigaPN - Counting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0001084">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N29c87e8c71ed44c98a715ba36eb918b4">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0001083"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">CobGlAnCol - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Standard method for cob tassel Anthocyanin coloration. The anthocyanin Anthocyanin colorationation should be observed on the middle third of the uppermost cob, after the removal of some of the grains.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_322:0000175">
    <ns1:definition xml:lang="en">Grain width.</ns1:definition>
