    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N489eb44d38ce4bf78536b60f39672619">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000020"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Use ear height and plant height data of the same plants per plot and calculate the ratio. Small values indicate low ear position; large values indicate high ear position.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">EPo - Computation</rdfs:label>
  </ns3:Class>
