        <rdfs:label>ACTUS cashflow category - ownership</rdfs:label>
        <skos:definition>cashflow category that applies to basic contracts processed as members of the ownership class</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Securitization -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Securitization">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory"/>
