        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <TextDatatype:hasTextValue>Fixed Income</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS cashflow category - fixed income</rdfs:label>
        <skos:definition>cashflow category that applies to basic contracts processed as members of the fixed-income class</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Ownership -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Ownership">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory"/>
