    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayFollowing -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayFollowing">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day following</rdfs:label>
        <skos:definition>convention specifying that a non-business date will be adjusted to the first following day that is a business day</skos:definition>
        <AnnotationVocabulary:adaptedFrom>FPML 5.1 &quot;BusinessDayConventionEnum&quot;</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayModifiedFollowing -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayModifiedFollowing">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day modified following</rdfs:label>
        <skos:definition>convention specifying that a non-business date will be adjusted to the first following day that is a business day unless that day falls in the next calendar month, in which case that date will be the first preceding day that is a calendar date</skos:definition>
        <AnnotationVocabulary:adaptedFrom>FPML 5.1 &quot;BusinessDayConventionEnum&quot;</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayModifiedPreceding -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayModifiedPreceding">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day modified preceding</rdfs:label>
        <skos:definition>convention specifying that a non-business date will be adjusted to the first preceding day that is a business day unless that day falls in the previous month, in which case that date will be the first following day that is a business day</skos:definition>
        <AnnotationVocabulary:adaptedFrom>FPML 5.1 &quot;BusinessDayConventionEnum&quot;</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayNearest -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayNearest">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day nearest</rdfs:label>
        <skos:definition>convention specifying that a non-business date will be adjusted to the nearest day that is a business day -- i.e. if the non-business day falls on any day other than a Sunday or a Monday, it will be the first preceding day that is a business day, and will be the first following business day if it falls on a Sunday or a Monday</skos:definition>
        <AnnotationVocabulary:adaptedFrom>FPML 5.1 &quot;BusinessDayConventionEnum&quot;</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayNone -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayNone">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day none</rdfs:label>
        <skos:definition>convention specifying that a date will not be adjusted if it falls on a day that is not a business day</skos:definition>
        <AnnotationVocabulary:adaptedFrom>FPML 5.1 &quot;BusinessDayConventionEnum&quot;</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayPreceding -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayPreceding">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/"/>
        <rdfs:label>business day preceding</rdfs:label>
        <skos:definition>convention specifying that a date will be adjusted to the first previous day that is a business day</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarMonth -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarMonth">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarPeriod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>calendar month</rdfs:label>
        <skos:definition>time interval resulting from the division of a calendar year in 12 time intervals, each with a specific name and containing a specific number of calendar days</skos:definition>
        <AnnotationVocabulary:adaptedFrom>ISO 8601, clause 2.2.11</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarQuarter -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarQuarter">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarPeriod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>calendar quarter</rdfs:label>
        <skos:definition>time interval of 3 months, starting on January 1, April 1, July 1, or October 1</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarWeek -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarWeek">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarPeriod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>calendar week</rdfs:label>
        <skos:definition>time interval of seven calendar days starting on a Monday</skos:definition>
        <AnnotationVocabulary:adaptedFrom>ISO 8601, clause 2.2.8</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarYear -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarYear">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarPeriod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>calendar year</rdfs:label>
        <skos:definition>cyclic time interval in a calendar which is required for one revolution of the Earth around the Sun and approximated to an integral number of calendar days; a year in the Gregorian calendar</skos:definition>
        <AnnotationVocabulary:adaptedFrom>ISO 8601 clause 2.2.13</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Friday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Friday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Friday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Saturday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/FromEnd -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/FromEnd">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/TimeDirection"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>from the end</rdfs:label>
        <skos:definition>time direction indicating that a calendar-specified date is the nth date from the end of a calendar period</skos:definition>
        <skos:example>Two days before the end of a calendar month.</skos:example>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/FromStart -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/FromStart">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/TimeDirection"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>from the start</rdfs:label>
        <skos:definition>time direction indicating that a calendar-specified date is the nth day from the beginning of a calendar period.</skos:definition>
        <skos:example>The first day of a calendar quarter. (The offsetDay is zero.)</skos:example>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Monday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Monday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Monday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Tuesday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Saturday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Saturday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Saturday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Sunday</skos:definition>
        <AnnotationVocabulary:explanatoryNote>One Saturday is the time interval that has duration 1 day and that starts Gregorian year 2000. This requirement anchors the repeating sequence of days of week to specific Gregorian days. It requires that January 1, 2000 is a Saturday. It follows that January 2, 2000 must be the Sunday that it meets, and so on.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Sunday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Sunday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Sunday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Monday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Thursday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Thursday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Thursday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Friday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Tuesday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Tuesday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Tuesday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Wednesday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Wednesday -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Wednesday">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/"/>
        <rdfs:label>Wednesday</rdfs:label>
        <skos:definition>time interval that has duration 1 day and that meets a Thursday</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Apartment -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Apartment">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">apartment</rdfs:label>
        <skos:definition>room or a group of related rooms, among similar sets in one building, designed for use as a dwelling</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Basement -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Basement">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">basement</rdfs:label>
        <skos:definition>part of a building consisting of rooms that are partly or entirely below ground</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Building -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Building">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">building</rdfs:label>
        <skos:definition>relatively permanent enclosed structure, that has a roof and walls and stands more or less permanently in one place</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Department -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Department">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">department</rdfs:label>
        <skos:definition>division of a large organization such as a government, university, business, or shop, dealing with a specific subject, commodity, or area of activity</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Floor -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Floor">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">floor</rdfs:label>
        <skos:definition>all of the rooms or areas on the same level of a building; a story</skos:definition>
        <AnnotationVocabulary:explanatoryNote>Labeling systems for floors vary from country to country, and may be specific to the building, for example, whether or not a 13th floor is identified as such tends to be on a case-by-case basis.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Front -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Front">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">front</rdfs:label>
        <skos:definition>side or part of a building that presents itself to view first, that faces the street; the most forward part of a building</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Hangar -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Hangar">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">hanger</rdfs:label>
        <skos:definition>shed or shelter; any relatively wide structure used for housing airplanes or airships</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Key -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Key">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">key</rdfs:label>
        <skos:definition>usually metal instrument by which the bolt of a lock is turned</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lobby -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lobby">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">lobby</rdfs:label>
        <skos:definition>entrance hall, corridor, or vestibule, as in a public building, often serving as an anteroom; foyer</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lot -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lot">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">lot</rdfs:label>
        <skos:definition>measured parcel of land having fixed boundaries and designated on a plot or survey</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lower -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lower">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">lower</rdfs:label>
        <skos:definition>floor of a building in a multistory structure that is closer to ground level</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Office -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Office">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">office</rdfs:label>
        <skos:definition>place where a particular kind of business is transacted or a service is supplied</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Penthouse -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Penthouse">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">penthouse</rdfs:label>
        <skos:definition>structure or dwelling on the roof or top floor of a building</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Pier -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Pier">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">pier</rdfs:label>
        <skos:definition>structure extending into navigable water for use as a landing place or promenade</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Rear -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Rear">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">rear</rdfs:label>
        <skos:definition>side or part of a building at the back, located opposite its front</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Room -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Room">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">room</rdfs:label>
        <skos:definition>partitioned part of the inside of a building</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Side -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Side">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">side</rdfs:label>
        <skos:definition>place, space, or direction with respect to a center or to a line of division</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Slip -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Slip">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">slip</rdfs:label>
        <skos:definition>sloping ramp extending out into the water to serve as a place for landing or repairing ships; ship&apos;s or boat&apos;s berth between two piers</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Space -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Space">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">space</rdfs:label>
        <skos:definition>extent set apart or available, such as a parking or storage space</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Stop -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Stop">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">stop</rdfs:label>
        <skos:definition>stopping place, such as a bus or mail stop</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Suite -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Suite">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">suite</rdfs:label>
        <skos:definition>group of rooms occupied as a unit</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Trailer -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Trailer">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">trailer</rdfs:label>
        <skos:definition>vehicle designed to serve wherever parked as a temporary dwelling or place of business</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Unit -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Unit">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <skos:definition>area in a facility, such as a medical facility or hospital that is specially staffed and equipped to provide a particular service or type of care</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Upper -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Upper">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator"/>
        <Addresses:requiresSecondaryUnitRange rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Addresses:requiresSecondaryUnitRange>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"/>
        <rdfs:label xml:lang="en">upper</rdfs:label>
        <skos:definition>floor of a building in a multistory structure that is farther away from the ground level</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Informative -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Informative">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/MaturityLevel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
        <rdfs:label>informative</rdfs:label>
        <skos:definition xml:lang="en">entity that is considered deprecated but included for informational purposes because it is referenced by some provisional concept</skos:definition>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">Informative content will be removed as soon as all dependencies have been eliminated, thus FIBO users should not depend on it going forward.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Provisional -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Provisional">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/MaturityLevel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
        <rdfs:label>provisional</rdfs:label>
        <skos:definition xml:lang="en">entity that is considered to be under development</skos:definition>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">Provisional content is subject to change, and may change substantially prior to release. FIBO users should be aware that it is not dependable, but could be used for reference and as the basis for further work.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Release -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Release">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/MaturityLevel"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
        <rdfs:label>release</rdfs:label>
        <skos:definition xml:lang="en">entity that is considered to be stable and mature from a development perspective</skos:definition>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">Release notes will be provided for any changes with respect to released content, and any revisions will be backwards compatible with the prior version to the degree possible.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForceParticipationRate -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForceParticipationRate">
        <QuantitiesAndUnits:describesActualExpression>civilian labor force ÷ civilian non-institutional population</QuantitiesAndUnits:describesActualExpression>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>civilian labor force participation rate</rdfs:label>
        <skos:definition>economic indicator representing the rate of participation the labor force of a given economy for some specified period</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.bls.gov/cps/definitions.htm#lfpr</AnnotationVocabulary:adaptedFrom>
        <AnnotationVocabulary:explanatoryNote>The labor force participation rate is the percentage of the population that is either employed or unemployed (that is, either working or actively seeking work).</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Daily -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Daily">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/ExplicitRecurrenceInterval"/>
        <DatesAndTimes:hasDurationValue>P1D</DatesAndTimes:hasDurationValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>daily</rdfs:label>
        <skos:definition>explicit recurrence interval of one day, or 24 hours</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmploymentPopulationRatio -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmploymentPopulationRatio">
        <QuantitiesAndUnits:describesActualExpression>employed population ÷ civilian non-institutional population</QuantitiesAndUnits:describesActualExpression>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>employment-population ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.bls.gov/news.release/pdf/empsit.pdf"/>
        <skos:definition>economic indicator representing the ratio of the employed population with respect to the overall civilian non-institutional population of a given economy for some specified period</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Hourly -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Hourly">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/ExplicitRecurrenceInterval"/>
        <DatesAndTimes:hasDurationValue>P1H</DatesAndTimes:hasDurationValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>hourly</rdfs:label>
        <skos:definition>explicit recurrence interval of one hour, or 60 minutes</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Monthly -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Monthly">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/ExplicitRecurrenceInterval"/>
        <DatesAndTimes:hasDurationValue>P1M</DatesAndTimes:hasDurationValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>monthly</rdfs:label>
        <skos:definition>explicit recurrence interval of exactly one (1) month, regardless of the length in days of a given calendar month, but typically 30 days</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnemploymentRate -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnemploymentRate">
        <QuantitiesAndUnits:describesActualExpression>unemployed population ÷ civilian labor force</QuantitiesAndUnits:describesActualExpression>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>unemployment rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.bls.gov/news.release/pdf/empsit.pdf"/>
        <skos:definition>economic indicator representing the ratio of the unemployed population with respect to the civilian labor force of a given economy for some specified period</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.bls.gov/cps/faq.htm#Ques3</AnnotationVocabulary:adaptedFrom>
        <AnnotationVocabulary:explanatoryNote>Persons are classified as unemployed if they do not have a job, have actively looked for work in the prior 4 weeks, and are currently available for work. Workers expecting to be recalled from layoff are counted as unemployed, whether or not they have engaged in a specific jobseeking activity. In all other cases, the individual must have been engaged in at least one active job search activity in the 4 weeks preceding the interview and be available for work (except for temporary illness).</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Weekly -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Weekly">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/ExplicitRecurrenceInterval"/>
        <DatesAndTimes:hasDurationValue>P7D</DatesAndTimes:hasDurationValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/"/>
        <rdfs:label>weekly</rdfs:label>
        <skos:definition>explicit recurrence interval of one week, or 7 days</skos:definition>
    </owl:NamedIndividual>
    


