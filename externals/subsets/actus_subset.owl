        <CountryRepresentation:hasEnglishShortNameInCapitals xml:lang="en">FRENCH SOUTHERN TERRITORIES</CountryRepresentation:hasEnglishShortNameInCapitals>
        <CountryRepresentation:hasFrenchShortName xml:lang="fr">Terres australes françaises (les)</CountryRepresentation:hasFrenchShortName>
        <CountryRepresentation:hasFrenchShortNameInCapitals xml:lang="fr">TERRES AUSTRALES FRANÇAISES</CountryRepresentation:hasFrenchShortNameInCapitals>
        <CountryRepresentation:hasNumericRegionCode>260</CountryRepresentation:hasNumericRegionCode>
        <CountryRepresentation:hasRemarks>Comprises: Amsterdam Island, Crozet Archipelago, Kerguelen Islands, Saint Paul Island and French scattered Indian Ocean Islands formed by Bassas da India, Europa Island, Glorioso Islands, Juan de Nova Island and Tromelin Island.</CountryRepresentation:hasRemarks>
        <CountryRepresentation:hasRemarks>No subdivisions relevant for this standard. Included also as subdivision of France (FR-TF).</CountryRepresentation:hasRemarks>
        <CountryRepresentation:isIndependent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</CountryRepresentation:isIndependent>
        <rdfs:isDefinedBy rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/"/>
        <rdfs:label xml:lang="fr">Terres australes françaises (les)</rdfs:label>
        <skos:definition>the country of French Southern Territories (the)</skos:definition>
    </owl:NamedIndividual>
    


