     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:Addresses="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/"
     xmlns:Relations="https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/"
     xmlns:Collections="https://www.omg.org/spec/Commons/Collections/"
     xmlns:Designators="https://www.omg.org/spec/Commons/Designators/"
     xmlns:Identifiers="https://www.omg.org/spec/Commons/Identifiers/"
     xmlns:TextDatatype="https://www.omg.org/spec/Commons/TextDatatype/"
     xmlns:DatesAndTimes="https://www.omg.org/spec/Commons/DatesAndTimes/"
     xmlns:Organizations="https://www.omg.org/spec/Commons/Organizations/"
     xmlns:CurrencyAmount="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/"
     xmlns:QuantitiesAndUnits="https://www.omg.org/spec/Commons/QuantitiesAndUnits/"
     xmlns:AnnotationVocabulary="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
     xmlns:AnnotationVocabulary1="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"
     xmlns:ContextualDesignators="https://www.omg.org/spec/Commons/ContextualDesignators/"
     xmlns:CountryRepresentation="https://www.omg.org/spec/LCC/Countries/CountryRepresentation/"
     xmlns:LanguageRepresentation="https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/"
     xmlns:ACTUSControlledVocabulary="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/">
