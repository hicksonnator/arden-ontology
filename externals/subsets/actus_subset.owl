        <rdfs:label>ACTUS cashflow category - securitization</rdfs:label>
        <skos:definition>cashflow category that applies to combined contracts processed as members of the securitization class</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory"/>
