        <rdfs:label>ACTUS cashflow category - symmetric</rdfs:label>
        <skos:definition>cashflow category that applies to combined contracts processed as members of the symmetric class</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType">
        <TextDatatype:hasTextValue>CT</TextDatatype:hasTextValue>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Annuity -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Annuity">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>classic level payment mortgages, leasing contracts, etc.</hasCoverageDescription>
        <TextDatatype:hasTextValue>ANN</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - annuity</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest is repaid periodically in constant amounts until maturity</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>If the contract has a variable rate, the total amount of principal and interest is recalculated to be fully matured at the maturity date.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-BondWithWarrant -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-BondWithWarrant">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/BondWithWarrant"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Warrants.</hasCoverageDescription>
        <TextDatatype:hasTextValue>BNDWR</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - bond with warrant</rdfs:label>
        <skos:definition>cashflow classifier that applies to bonds with attached warrants</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-BoundaryControlledSwitch -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-BoundaryControlledSwitch">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Knock-in and Knock-out barrier options with a single boundary. Bonus contracts with payout when underlying asset price remains above or below a specified level for specified period.</hasCoverageDescription>
        <TextDatatype:hasTextValue>BCS</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - boundary controlled switch</rdfs:label>
        <skos:definition>cashflow classifier that applies to derivative contracts with subcontract legs which can be activated (knocked in) or extinguished (knocked out) when the underlying asset price reaches a specified value</skos:definition>
        <skos:editorialNote>Need to figure out what restrictions are needed on derivative instrument to limit the coverage to the right set of agreements, and then map to those.</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
        <skos:note>The underlying asset may be a stock, index, or exchange-traded fund. Boundary controlled switch contracts with a single boundary are currently defined.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CallMoney -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CallMoney">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/CommercialLoans/CommercialLoan"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasCallFeature"/>
                                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallFeature"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Interbank loans with call features.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CLM</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - call money</rdfs:label>
        <skos:definition>cashflow classifier that applies to loans that are rolled over as long as they are not called</skos:definition>
        <skos:editorialNote>Need to figure out whether this only applies to commercial loans and whether additional restrictions are needed to limit coverage to loans whose borrowers and lenders are financial institutions, possibly other things (short term?, interbank only?).</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Once called, they must be repaid after the stipulated notice period.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CapFloorOption -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CapFloorOption">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/InterestRateOption"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Cap and floor options.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CAPFL</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - cap floor option</rdfs:label>
        <skos:definition>cashflow classifier that applies to interest rate options expressed with a maximum or minimum interest rate</skos:definition>
        <skos:editorialNote>Need to figure out what restrictions are needed on derivative instrument to limit the coverage to the right set of agreements, and then map to those.</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Cash -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Cash">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CashInstrument"/>
                            <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentOrDepositAccount"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Cash, deposits at a central or other institution</hasCoverageDescription>
        <TextDatatype:hasTextValue>CSH</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - cash</rdfs:label>
        <skos:definition>cashflow classifier that applies to cash or cash equivalent positions</skos:definition>
        <skos:editorialNote>Rather than classifying the account, should this classify the value of the funds held in that account or something similar?</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Ownership"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Collateral -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Collateral">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Mortgages include a collateral contract. Any coverage with financial or physical collateral.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CEC</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - collateral</rdfs:label>
        <skos:definition>cashflow classifier that applies to relationships between collateral, an obligee and a debtor, covering the exposure from the debtor with the collateral</skos:definition>
        <skos:editorialNote>Rather than classifying the collateral agreement, should this classify any debt instrument that is collateralized?</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-CreditEnhancement"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-CreditEnhancement"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Commodity -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Commodity">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CommodityInstrument"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Oil, gas, electricity, houses etc.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CEC</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - commodity</rdfs:label>
        <skos:definition>cashflow classifier that applies to movements of commodities such as oil, gas or even houses that can serve as underlyings of commodity futures, guarantees or simply asset positions</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Ownership"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ConvertibleNote -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ConvertibleNote">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasCallFeature"/>
                                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallFeature"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasPutFeature"/>
                                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PutFeature"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Callable and puttable bonds or loans.</hasCoverageDescription>
        <TextDatatype:hasTextValue>BNDCP</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - convertible note</rdfs:label>
        <skos:definition>cashflow classifier that applies to bonds with a call or put option</skos:definition>
        <skos:editorialNote>Should this also only classify contracts that are convertible? Does this mean an additional restriction? Does it really apply to any sort of loan?</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
        <skos:note>If the option is exercised, the underlying bond ceases to exist.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CreditDefaultSwap -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CreditDefaultSwap">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/CreditDefaultSwap"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>All sorts of credit default swaps.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CDSWP</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - credit default swap</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts for which a payment is triggered if one or more of the underlying counterparties defaults</skos:definition>
        <skos:editorialNote>Is this really limited to CDS, or should it apply to anything (or maybe any derivative) where one of the parties to an underlying contract that triggers payment defaults?</skos:editorialNote>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CreditLinkedNote -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CreditLinkedNote">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <TextDatatype:hasTextValue>CLNTE</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - credit linked note</rdfs:label>
        <skos:definition>cashflow classifier that applies to securities with an embedded credit default swap, linking the credit risk of a reference entity to the note&apos;s performance</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticAnnuity -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticAnnuity">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>A special version of this kind are teaser rate loans and mortgages with annuity features.</hasCoverageDescription>
        <TextDatatype:hasTextValue>ANX</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - exotic annuity</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest payments may include step ups in principal and/or interest until maturity</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Highly flexible to match totally irregular principal payments. Principal can also be paid out in steps.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticLinearAmortizer -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticLinearAmortizer">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>A special version of this kind are teaser rate loans and mortgages.</hasCoverageDescription>
        <TextDatatype:hasTextValue>LAX</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - exotic linear amortizer</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is typically, but not always, paid fully at the initial exchange date and where the principal is typically repaid in equal amounts until a step change or maturity, with interest payments decreasing accordingly until a step change in the interest amount</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Loans with highly flexible schedules to match totally irregular principal payments are possible. In such cases, the principal can also be paid out in steps.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticNegativeAmortizer -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticNegativeAmortizer">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>A special version of this kind are teaser rate loans and mortgages with a variable maturity date.</hasCoverageDescription>
        <TextDatatype:hasTextValue>NAX</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - exotic negative amortizer</rdfs:label>
        <skos:definition>cashflow classifier that applies to negative amortizing contracts but allowing step ups in principal and interest</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Highly flexible to match totally irregular principal payments. Principal can also be paid out in steps.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticOption -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ExoticOption">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/ExoticOption"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Knock-in and Knock-out, Barrier, Ladder, Rainbow options etc.</hasCoverageDescription>
        <TextDatatype:hasTextValue>EXOTi</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - exotic option</rdfs:label>
        <skos:definition>cashflow classifier that applies to exotic options</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
        <skos:note>As of current, most of the exotic options which were popular before 2008 are out of favor and factually irrelevant. Which of the exotic options will be implemented will depend on the real relevance in the future.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ForeignExchangeOutright -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ForeignExchangeOutright">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Standard interest rate, FX, stock and commodity futures.</hasCoverageDescription>
        <TextDatatype:hasTextValue>FXOUT</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - foreign exchange outright</rdfs:label>
        <skos:definition>cashflow classifier that applies to agreements where two parties agree to exchange fixed cash flows in different currencies at a specified future date</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Future -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Future">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Standard interest rate, FX, stock and commodity futures.</hasCoverageDescription>
        <TextDatatype:hasTextValue>FUTUR</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - future</rdfs:label>
        <skos:definition>cashflow classifier that applies to futures</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric"/>
        <skos:note>Keeps track of value changes for any basic contract as underlying (PAM, ANN etc. but also FXOUT, STK, COM). Handles margining calls.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Guarantee -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Guarantee">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditEnhancementAgreement"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Personal guarantee. Government guarantee. Underlyings of CDO&apos;s.</hasCoverageDescription>
        <TextDatatype:hasTextValue>CEG</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - guarantee</rdfs:label>
        <skos:definition>cashflow classifier that applies to credit enhancements that create a relationship between a guarantor, an obligee and a debtor, moving the exposure from the debtor to the guarantor</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-CreditEnhancement"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-CreditEnhancement"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-LinearAmortizer -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-LinearAmortizer">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Standard amortizing loans with fixed principal repayments.</hasCoverageDescription>
        <TextDatatype:hasTextValue>LAM</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - linear amortizer</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and where the principal is repaid in equal amounts until maturity, with interest payments decreasing accordingly</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Interest payments decrease over time as the outstanding principal reduces.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Margining -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Margining">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Margin contracts as applied in central depositories for any underlying or portfolio of underlying instruments.</hasCoverageDescription>
        <TextDatatype:hasTextValue>MAR</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - margining</rdfs:label>
        <skos:definition>cashflow classifier that applies to margin contracts that traces the value changes and the different margin categories like inital and variation margin</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-CreditEnhancement"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-CreditEnhancement"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-NegativeAmortizer -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-NegativeAmortizer">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Special class of ARMs (adjustable rate mortgages), certain other loans, with payment caps.</hasCoverageDescription>
        <TextDatatype:hasTextValue>NAM</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - negative amortizer</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest is repaid periodically in constant amounts until maturity, however, when resetting the rate, the total payment (principal plus interest remains constant) thus the maturity changes</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>For loans where scheduled payments are insufficient to cover interest due to an increase in the rate, the principal increases with deferred interest payments leading to growing principal balances, and extending the maturity date.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Option -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Option">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>European, American and Bermudan options with Interest rate, FX and stock futures as underlying instruments.</hasCoverageDescription>
        <TextDatatype:hasTextValue>OPTNS</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - option</rdfs:label>
        <skos:definition>cashflow classifier that calculates straight option pay-off for any basic contract as underlying (PAM, ANN etc.) but also SWAPS, FXOUT, STK and COM</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
        <skos:note>Single, periodic and continuous strike is supported.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PerpetualBond -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PerpetualBond">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/PerpetualBond"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Consoles, war loans.</hasCoverageDescription>
        <TextDatatype:hasTextValue>PBN</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - perpetual bond</rdfs:label>
        <skos:definition>cashflow classifier that applies to bonds without any maturity date</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Interest is paid into eternity if is not terminated.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PlainVanillaSwap -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PlainVanillaSwap">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/RateDerivatives/IRSwaps/PlainVanillaInterestRateSwap"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>More than 90% of all interest rate swaps follow this simple pattern.</hasCoverageDescription>
        <TextDatatype:hasTextValue>SWPPV</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - plain vanilla swap</rdfs:label>
        <skos:definition>cashflow classifier that applies to swaps where the underlyings are always two identical PAM&apos;s however with one leg fixed and the other variable</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PrincipalAtMaturity -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-PrincipalAtMaturity">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidAtMaturity"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>all kinds of bonds, term deposits, bullet loans, and so forth</hasCoverageDescription>
        <TextDatatype:hasTextValue>PAM</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - principal at maturity</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and repaid at maturity</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-RepurchaseAgreement -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-RepurchaseAgreement">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/TradedShortTermDebt/RepurchaseAgreement"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Classical repo and reverse repo agreements.</hasCoverageDescription>
        <TextDatatype:hasTextValue>REP</TextDatatype:hasTextValue>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - repurchase agreement</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts that control and manage the sale and repurchase of assets on the books</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-CreditEnhancement"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-CreditEnhancement"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-SecuritizationCreditRisk -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-SecuritizationCreditRisk">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/PoolBackedSecurities/PoolBackedSecurity"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>CDOs</hasCoverageDescription>
        <TextDatatype:hasTextValue>SCRCR</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - securitization credit risk</rdfs:label>
        <skos:definition>cashflow classifier that applies to securitization contracts ranked according to credit default</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Securitization"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-SecuritizationMarketRisk -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-SecuritizationMarketRisk">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/PoolBackedSecurities/PoolBackedSecurity"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>ABS&apos;s, MBS&apos;s of all sorts. Could be a simple tranche or more complex tranch like interest only and principal only.</hasCoverageDescription>
        <TextDatatype:hasTextValue>SCRMR</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - securitization market risk</rdfs:label>
        <skos:definition>cashflow classifier that applies to securitization contracts where all underlying contracts are treated equally</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Securitization"/>
        <skos:note>The buyer of a tranche gets a part of the cash-flows.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Stock -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Stock">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/EquityInstrument"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>All straight stocks.</hasCoverageDescription>
        <TextDatatype:hasTextValue>STK</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - stock</rdfs:label>
        <skos:definition>cashflow classifier that applies to equity instruments representing ownership in a company, that is bought at a certain amount (normally market price), that then follows an index</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Ownership"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Swap -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Swap">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/Swap"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>All kind of swaps. The variety is defined by the underlying CT&apos;s which often are PAM and ANN in all its flavors. With each new basic CT the variety rises.</hasCoverageDescription>
        <TextDatatype:hasTextValue>SWAPS</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - swap</rdfs:label>
        <skos:definition>cashflow classifier that applies to derivative contracts where two parties exchange contracts</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric"/>
        <skos:note>Normally one leg is fixed, the other variable. However all variants possible including different currencies for cross currency swaps, basic swaps or even different principal exchange programs.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-TotalReturnSwap -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-TotalReturnSwap">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Documents/refersTo"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/TotalReturnSwap"/>
            </owl:Restriction>
        </rdf:type>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <TextDatatype:hasTextValue>TRSWP</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - total return swap</rdfs:label>
        <skos:definition>cashflow classifier that applies to swaps in which one party makes payments based on a set rate, either fixed or variable, while the other party makes payments based on the return of an underlying asset, which includes both the income it generates and any capital gains</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-UndefinedMaturityProfile -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-UndefinedMaturityProfile">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
        <Collections:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <Designators:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
        <hasCoverageDescription>Saving products of all kind, current accounts. In some countries even variable rate mortgages can be represented with this contract type.</hasCoverageDescription>
        <TextDatatype:hasTextValue>UMP</TextDatatype:hasTextValue>
        <terms:source>https://www.actusfrf.org/taxonomy</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>ACTUS contract type - undefined maturity profile</rdfs:label>
        <skos:definition>cashflow classifier that applies to contracts whose principal may be paid in and out at any point in time without prefixed schedule</skos:definition>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
        <skos:isNarrowerThan rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
        <skos:note>Interest calculated on outstanding and capitalized periodically. Needs link to a behavioral function describing expected flows.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme"/>
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.omg.org/spec/Commons/Designators/defines"/>
                <owl:someValuesFrom rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
            </owl:Restriction>
        </rdf:type>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/"/>
        <rdfs:label>Algorithmic Contract Types classification scheme</rdfs:label>
        <skos:definition>classification scheme behind the ACTUS modeling paradigm, in which standardized Contract Types (CTs) are the granular building blocks of the financial world</skos:definition>
        <AnnotationVocabulary:abbreviation>ACTUS classification scheme</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.actusfrf.org/methodology</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingPeriod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingPeriod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipPeriodQualifier"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>accounting period</rdfs:label>
        <skos:definition>qualifier indicating that the relationship period reflects the period of time covered by the most recent validation documents from an accounting perspective for this relationship</skos:definition>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/DocumentFilingPeriod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/DocumentFilingPeriod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipPeriodQualifier"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>document filing period</rdfs:label>
        <skos:definition>a qualifier indicating that the relationship period reflects the validity period for any regulatory filing, accounting document, other document demonstrating the relationship&apos;s validity</skos:definition>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/GenerallyAcceptedAccountingPrinciples -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/GenerallyAcceptedAccountingPrinciples">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingFramework"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>Generally Accepted Accounting Principles</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.fasb.org/home"/>
        <skos:definition>an accounting framework developed by the US Financial Accounting Standards Board (FASB)</skos:definition>
        <AnnotationVocabulary:abbreviation>GAAP</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:abbreviation>US GAAP</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ISO17442-CodeSet -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ISO17442-CodeSet">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>ISO 17442 code set</rdfs:label>
        <skos:definition>the set of legal entity identifiers that comprise the ISO 17442 legal entity identifier specification</skos:definition>
        <AnnotationVocabulary:synonym>GLEIF LEI CDF v2.1 legal entity identifier (LEI) code set</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ISO20275-CodeSet -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ISO20275-CodeSet">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>ISO 20275 code set</rdfs:label>
        <skos:definition>the set of entity legal form identifiers that comprise the ISO 20275 entity legal form specification</skos:definition>
        <AnnotationVocabulary:synonym>entity legal form (ELF) code set</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/InternationalFinancialReportingStandard -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/InternationalFinancialReportingStandard">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingFramework"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>International Financial Reporting Standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ifrs.org/"/>
        <skos:definition>an accounting framework developed by the International Accounting Standards Board (IASB)</skos:definition>
        <AnnotationVocabulary:abbreviation>IFRS</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/OtherAccountingFramework -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/OtherAccountingFramework">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingFramework"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>other accounting framework</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ifrs.org/"/>
        <skos:definition>an accounting framework of unstated origin (other than IFRS or US GAAP)</skos:definition>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatusActive -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatusActive">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>relationship status - active</rdfs:label>
        <skos:definition>status indicating that as of the last report or update, the reporting legal entity reported that it is legally registered and/or operating, and that the relationship detailed in this relationship record is still valid</skos:definition>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatusInactive -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatusInactive">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/"/>
        <rdfs:label>relationship status - inactive</rdfs:label>
        <skos:definition>status indicating that it has been determined that the relationship ended, e.g. because entity that reported this relationship is no longer legally registered and/or operating; or the relationship is no longer valid for other reasons</skos:definition>
        <AnnotationVocabulary:adaptedFrom>GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierReferenceDataLibrary -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierReferenceDataLibrary">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry"/>
        <Organizations:isManagedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierServiceProvider"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/"/>
        <rdfs:label>unique product identifier reference data library</rdfs:label>
        <skos:definition>set of data comprised of reference data elements with specific values that together describe the product</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierServiceProvider -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierServiceProvider">
        <terms:source>ISO 4914:2021(en), Financial services - Unique product identifier (UPI)</terms:source>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/"/>
        <rdfs:label>unique product identifier service provider</rdfs:label>
        <skos:definition>organization designated by an external body of financial regulators to assign UPIs and operate a UPI reference data library</skos:definition>
        <skos:scopeNote>At the time of publication of the ISO 4914 standard, there was only one such provider, the Regulatory Oversight Committee, confirmed by the Financial Stability Board as the International Governance Body for globally harmonised identifiers used to track OTC derivatives transactions.</skos:scopeNote>
        <AnnotationVocabulary:abbreviation>UPI service provider</AnnotationVocabulary:abbreviation>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/AtTheMoney -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/AtTheMoney">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/Moneyness"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/"/>
        <rdfs:label xml:lang="en">at-the-money</rdfs:label>
        <skos:definition xml:lang="en">moneyness classifier that refers to an option whose value in terms of its strike price is the same or close to the current market price of the underlying security</skos:definition>
        <AnnotationVocabulary:abbreviation xml:lang="en">ATM</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">An ATM option has a delta of ±0.50, positive if it is a call, negative for a put.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/InTheMoney -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/InTheMoney">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/Moneyness"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/"/>
        <rdfs:label xml:lang="en">in-the-money</rdfs:label>
        <skos:definition xml:lang="en">moneyness classifier that refers to an option that has value in a strike price that is favorable in comparison to the prevailing market price of the underlying asset</skos:definition>
        <AnnotationVocabulary:abbreviation xml:lang="en">ITM</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">An in-the-money call option means the option holder has the opportunity to buy the security below its current market price. An in-the-money put option means the option holder can sell the security above its current market price.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/OutOfTheMoney -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/OutOfTheMoney">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/Moneyness"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/"/>
        <rdfs:label xml:lang="en">out-of-the-money</rdfs:label>
        <skos:definition xml:lang="en">moneyness classifier that refers to an option whose value in terms of its strike price is not favorable in comparison to the prevailing market price of the underlying asset</skos:definition>
        <AnnotationVocabulary:abbreviation xml:lang="en">OTM</AnnotationVocabulary:abbreviation>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">An OTM call option will have a strike price that is higher than the market price of the underlying asset. Alternatively, an OTM put option has a strike price that is lower than the market price of the underlying asset.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30360BondBasis -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30360BondBasis">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention 30/360 bond basis</rdfs:label>
        <skos:definition>day-count convention that uses 30 days in a month and 360 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ISDA 2006 Section 4.16(f), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>30A/360</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30360US -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30360US">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention 30/360 US</rdfs:label>
        <skos:definition>day-count convention that uses 30 days in a month and 360 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ISDA 2006 Section 4.16(f), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:explanatoryNote>This convention is used for US corporate bonds and many US agency issues. It is most commonly referred to as &apos;30/360&apos;, but the term &apos;30/360&apos; may also refer to any of the other conventions of this class, depending on the context. See ISDA 2006 Section 4.16(f), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>30/360</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30365 -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30365">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention 30/365</rdfs:label>
        <skos:definition>day-count convention that uses 30 days in a month and 365 days in a year for calculating interest payments</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30E360 -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30E360">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention 30E/360</rdfs:label>
        <skos:definition>day-count convention that uses 30 days in a month and 360 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ICMA Rule 251.1(ii), 251.2, and ISDA 2006 Section 4.16(g), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>30/360 ICMA</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>30S/360</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>Eurobond basis (ISDA 2006)</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>Special German</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30E360ISDA -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-30E360ISDA">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention 30E/360 ISDA</rdfs:label>
        <skos:definition>day-count convention that uses 30 days in a month and 360 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ISDA 2006 Section 4.16(h), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>30/360 ICMA</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>Eurobond basis (ISDA 2006)</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>German</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-Actual360 -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-Actual360">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention actual/360</rdfs:label>
        <skos:definition>day-count convention that uses the actual number of days in each month and 360 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ICMA Rule 251.1(i) (not sterling), ISDA 2006 Section 4.16(e), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:explanatoryNote>This convention is used in money markets for short-term lending of currencies, including the US dollar and Euro, and is applied in ESCB monetary policy operations. It is the convention used with repurchase agreements.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>French</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>a/360</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>act/360</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-Actual365Fixed -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-Actual365Fixed">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention actual/365 fixed</rdfs:label>
        <skos:definition>day-count convention that uses the actual number of days in each month and 365 days in a year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ISDA 2006 Section 4.16(d), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>English</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>a/365 fixed</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>a/365f</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>act/365 fixed</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-ActualActualICMA -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-ActualActualICMA">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention actual/actual ICMA</rdfs:label>
        <skos:definition>day-count convention that uses the actual number of days in each month and actual number of days in that year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ICMA Rule 251.1(iii), ISDA 2006 Section 4.16(c), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:explanatoryNote>This method ensures that all coupon payments are always for the same amount. It also ensures that all days in a coupon period are valued equally. This is the convention used for US Treasury bonds and notes, among other securities.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>ISMA-99</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>act/act ICMA</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>act/act ISMA</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>actual/actual</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-ActualActualISDA -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention-ActualActualISDA">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/"/>
        <rdfs:label>day-count convention actual/actual ISDA</rdfs:label>
        <skos:definition>day-count convention that uses the actual number of days in each month and actual number of days in that year for calculating interest payments</skos:definition>
        <AnnotationVocabulary:explanatoryNote>See ISDA 2006 Section 4.16(b), https://web.archive.org/web/20140913145444/http://www.hsbcnet.com/gbm/attachments/standalone/2006-isda-definitions.pdf for more details on the calculation.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:explanatoryNote>This convention accounts for days in the period based on the portion in a leap year and the portion in a non-leap year.</AnnotationVocabulary:explanatoryNote>
        <AnnotationVocabulary:synonym>act/365</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>act/act</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>actual/365</AnnotationVocabulary:synonym>
        <AnnotationVocabulary:synonym>actual/actual</AnnotationVocabulary:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/AuctionMethod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/AuctionMethod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/"/>
        <rdfs:label xml:lang="en">auction method</rdfs:label>
        <skos:definition xml:lang="en">method for determining a price that represents use of an independently administered synthetic auction</skos:definition>
        <AnnotationVocabulary:explanatoryNote xml:lang="en">Auction method refers to a process where buyers enter competitive bids and sellers submit competitive offers at the same time. The price at which a security trades represents the highest price that a buyer is willing to pay and the lowest price that a seller is willing to accept. Matching bids and offers are then paired together, and the orders are executed.</AnnotationVocabulary:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MeanPriceDetermination -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MeanPriceDetermination">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/"/>
        <rdfs:label xml:lang="en">mean price determination</rdfs:label>
        <skos:definition xml:lang="en">method for determining a price that represents the arithmetic mean of some set of prices consolidated across sources</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryInCash -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryInCash">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/"/>
        <rdfs:label>delivery in cash</rdfs:label>
        <skos:definition>commitment to deliver an amount of money at the earliest available date as per settlement convention</skos:definition>
        <AnnotationVocabulary:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment"/>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/ElectAtExerciseMethod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/ElectAtExerciseMethod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/"/>
        <rdfs:label xml:lang="en">elect at exercise method</rdfs:label>
        <skos:definition xml:lang="en">commitment to determine the delivery strategy at the time of exercise</skos:definition>
        <AnnotationVocabulary:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/NonDeliverableMethod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/NonDeliverableMethod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/"/>
        <rdfs:label xml:lang="en">non-deliverable method</rdfs:label>
        <skos:definition xml:lang="en">commitment with respect to synthetic options on foreign exchange forwards that are based on non-convertible or thinly traded currencies</skos:definition>
        <AnnotationVocabulary:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/PhysicalDeliveryMethod -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/PhysicalDeliveryMethod">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/DeliveryMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/"/>
        <rdfs:label xml:lang="en">physical delivery method</rdfs:label>
        <skos:definition xml:lang="en">commitment to settle an obligation through the receipt or delivery of the actual underlying instrument(s) or other asset, such as a commodity, instead of through cash settlement</skos:definition>
        <AnnotationVocabulary:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/ActiveStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/ActiveStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus"/>
        <Relations:hasTag>ACTIVE</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>active status</rdfs:label>
        <skos:definition>status indicating that as of the last report or update, the entity was legally registered and operating</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/AnnulledStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/AnnulledStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>ANNULLED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>annulled status</rdfs:label>
        <skos:definition>status indicating that the registration was determined to be erroneous or invalid after issuance</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/CancelledStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/CancelledStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>CANCELLED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>cancelled status</rdfs:label>
        <skos:definition>status indicating that the registration was abandoned prior to issuance</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/DuplicateStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/DuplicateStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>DUPLICATE</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>duplicate status</rdfs:label>
        <skos:definition>status indicating that the registration was determined to be a duplicate registration of the same entity as another registration; duplicate status is assigned to the non-surviving registration (i.e. the identifier that should no longer be used)</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonCorporateAction -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonCorporateAction">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason"/>
        <Relations:hasTag>CORPORATE_ACTION</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity expiration reason - corporate action</rdfs:label>
        <skos:definition>expiration reason indicating that an entity was acquired or merged with another entity</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonDissolved -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonDissolved">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason"/>
        <Relations:hasTag>DISSOLVED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity expiration reason - disolved</rdfs:label>
        <skos:definition>expiration reason indicating that an entity ceased to operate</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonOther -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReasonOther">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason"/>
        <Relations:hasTag>OTHER</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity expiration reason - other</rdfs:label>
        <skos:definition>expiration reason indicating something that is neither due to disolution nor corporate action</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelEntitySuppliedOnly -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelEntitySuppliedOnly">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel"/>
        <Relations:hasTag>ENTITY_SUPPLIED_ONLY</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity validation level - entity-supplied only</rdfs:label>
        <skos:definition>Based on the validation procedures in use by the LOU responsible for the record, the information associated with this record has significant reliance on the information that a submitter provided due to the unavailability of corroborating information.</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelFullyCorroborated -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelFullyCorroborated">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel"/>
        <Relations:hasTag>FULLY_CORROBORATED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity validation level - fully corroborated</rdfs:label>
        <skos:definition>Based on the validation procedures in use by the LOU responsible for the record, there is sufficient information contained in authoritative public sources to corroborate the information that the submitter has provided for the record.</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelPartiallyCorroborated -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevelPartiallyCorroborated">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel"/>
        <Relations:hasTag>PARTIALLY_CORROBORATED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>entity validation level - partially corroborated</rdfs:label>
        <skos:definition>Based on the validation procedures in use by the LOU responsible for the record, the information supplied by the registrant can be partially corroborated by public authoritative sources, while some of the record is dependent upon the information that the registrant submitted, either due to conflicts with authoritative information, or due to data unavailability.</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/InactiveStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/InactiveStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus"/>
        <Relations:hasTag>INACTIVE</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>inactive status</rdfs:label>
        <skos:definition>status indicating that the entity is no longer legally registered and/or operating, whether as a result of business closure, acquisition by or merger with another (or new) entity, or determination of illegitimacy</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/IssuedStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/IssuedStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>ISSUED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>issued status</rdfs:label>
        <skos:definition>status indicating that the registration has been validated and issued, and which identifies an entity that was operating legally as of the last update</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/LapsedStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/LapsedStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>LAPSED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>lapsed status</rdfs:label>
        <skos:definition>status indicating that the registration that has not been renewed by the specified renewal date and is not known by public sources to have ceased operation as of the last update</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/MergedStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/MergedStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>MERGED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>merged status</rdfs:label>
        <skos:definition>status indicating that the registration is for an entity that has been merged into another legal entity, such that this legal entity no longer exists as an independently operating entity</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingArchivalStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingArchivalStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>PENDING_ARCHIVAL</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>pending archival status</rdfs:label>
        <skos:definition>status indicating that the registration is about to be transferred to a different registration authority, after which its registration status will revert to a non-pending status</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingTransferStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingTransferStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>PENDING_TRANSFER</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>pending transfer status</rdfs:label>
        <skos:definition>status indicating that the registration has requested transfer to a different registration authority, and for which transfer is in progress</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingValidationStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/PendingValidationStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>PENDING_VALIDATION</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>pending validation status</rdfs:label>
        <skos:definition>status indicating that an application for registration has been submitted and is in process, pending validation</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RetiredStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RetiredStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>RETIRED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>retired status</rdfs:label>
        <skos:definition>status indicating that the registration is for an entity that has ceased operation, without having been merged into another entity</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/TransferredStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/TransferredStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus"/>
        <Relations:hasTag>TRANSFERRED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/"/>
        <rdfs:label>transferred status</rdfs:label>
        <skos:definition>status indicating that the registration that has been transferred to a different registration authority</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ActiveMICStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ActiveMICStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus"/>
        <Relations:hasTag>ACTIVE</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/"/>
        <rdfs:label>active MIC status</rdfs:label>
        <skos:definition>market identifier code status that indicates that as of the last report or update, the code was registered and actively in use</skos:definition>
        <AnnotationVocabulary:adaptedFrom>ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), version 2.0</AnnotationVocabulary:adaptedFrom>
        <AnnotationVocabulary:adaptedFrom>https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ExpiredMICStatus -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ExpiredMICStatus">
        <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus"/>
        <Relations:hasTag>EXPIRED</Relations:hasTag>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/"/>
        <rdfs:label>expired MIC status</rdfs:label>
        <skos:definition>as of the last report or update, the exchange code has expired</skos:definition>
        <AnnotationVocabulary:adaptedFrom>ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, version 2.0</AnnotationVocabulary:adaptedFrom>
        <AnnotationVocabulary:adaptedFrom>https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf</AnnotationVocabulary:adaptedFrom>
    </owl:NamedIndividual>
    


    <!-- https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ISO10383-ClassificationScheme -->

    <owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ISO10383-ClassificationScheme">
        <rdf:type rdf:resource="https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme"/>
        <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/"/>
        <rdfs:label>ISO 10383 classification scheme</rdfs:label>
        <skos:definition>classification scheme for market categories and related content per the ISO 10383 standard</skos:definition>
        <AnnotationVocabulary:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso20022.org/market-identifier-codes</AnnotationVocabulary:adaptedFrom>
