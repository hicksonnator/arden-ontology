            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Frog eye assessment</rdfs:label>
        <skos:definition xml:lang="en">Visual assessment of 1-5 affected leaf area with frog eye</skos:definition>
    </owl:Class>
    


    <!-- https://cropontology.org/rdf/CO_336:0000014 -->

    <owl:Class rdf:about="https://cropontology.org/rdf/CO_336:0000014">
