        <rdfs:label xml:lang="en">Nodulation</rdfs:label>
        <skos:definition xml:lang="en">Root nodule formation due to interaction with microorganisms.</skos:definition>
        <acronym xml:lang="en">NODULE</acronym>
        <attribute>Nodulation</attribute>
        <entity>Root</entity>
    </owl:Class>
    


