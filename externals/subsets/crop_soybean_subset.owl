        <rdfs:label xml:lang="en">Root knot nematode</rdfs:label>
        <skos:definition xml:lang="en">Large galls or knots on the root system caused by Meloidogyne Spp</skos:definition>
        <acronym xml:lang="en">ROOTKNOT</acronym>
        <attribute>Reaction to Root knot nematode</attribute>
