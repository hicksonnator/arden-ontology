@prefix : <https://example.org/data#> .
@prefix arden-fin: <https://arden.ag/ont/fin#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:modelRMA a arden-fin:EstimationModel ;
  rdfs:label "RMA Yield Prediction Model"@en .

:est1 a arden-fin:ModeledEstimate ;
  arden-fin:wasGeneratedByModel :modelRMA ;
  prov:generatedAtTime "2023-09-15T00:00:00Z"^^xsd:dateTime ;
  sosa:resultTime "2023-09-15T00:00:00Z"^^xsd:dateTime ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "178.0"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] .

:est2 a arden-fin:ModeledEstimate ;
  arden-fin:wasGeneratedByModel :modelRMA ;
  prov:generatedAtTime "2023-09-20T00:00:00Z"^^xsd:dateTime ;
  sosa:resultTime "2023-09-20T00:00:00Z"^^xsd:dateTime ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "182.3"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] .