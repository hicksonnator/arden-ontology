@prefix dcat: <http://www.w3.org/ns/dcat#> .

# DCAT Dataset Metadata
<https://arden.ag/datasets/rma-sob-2023> a dcat:Dataset ;
  dct:title "RMA Summary of Business (Iowa, 2023)"@en ;
  dct:description "Crop insurance policies, prevented planting events, and yield estimates with full provenance tracking."@en ;
  dct:publisher "USDA RMA" ;
  dct:source <https://www.rma.usda.gov/SummaryOfBusiness> ;
  dct:issued "2024-01-15"^^xsd:date ;
  dct:spatial "Iowa, USA" ;
  dct:temporal [
    dct:startDate "2023-01-01"^^xsd:date ;
    dct:endDate "2023-12-31"^^xsd:date
  ] ;
  dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
  dcat:keyword "insurance", "risk", "prevented planting", "rma", "iowa" ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/AGRI> .

# RMA Summary of Business (SoB) 2023 Data - Iowa Counties
# Source: USDA RMA Data Mart - Public Domain
# Crop Insurance Indemnities and Prevented Planting

# RMA Data Source
:rma_datamart a <http://www.w3.org/ns/dcat#Dataset> ;
  dct:title "USDA RMA Summary of Business"@en ;
  dct:source <https://www.rma.usda.gov/SummaryOfBusiness> ;
  dct:publisher "USDA Risk Management Agency"@en .

# RMA Estimation Models
:rma_apt_model a arden-fin:EstimationModel ;
  rdfs:label "RMA Actual Production History (APH) Tool"@en ;
  dct:description "Official RMA yield estimation model for crop insurance"@en .

:rma_pp_model a arden-fin:EstimationModel ;
  rdfs:label "RMA Prevented Planting Model"@en ;
  dct:description "RMA model for prevented planting indemnity calculations"@en .

# Crop Insurance Policies - Polk County
:policy_polk_corn_2023 a arden-fin:InsurancePolicy ;
  rdfs:label "Polk County Corn Insurance 2023"@en ;
  arden:locatedInCounty :fips_19153 ;
  dct:coverage :crop_corn ;
  <https://example.org/policyYear> "2023"^^xsd:gYear ;
  <https://example.org/totalPremium> [
    a qudt:QuantityValue ;
    qudt:numericValue "8234567.45"^^xsd:decimal ;
    qudt:unit unit:Dollar
  ] ;
  <https://example.org/liabilityAmount> [
    a qudt:QuantityValue ;
    qudt:numericValue "156789012.34"^^xsd:decimal ;
    qudt:unit unit:Dollar
  ] ;
  arden:sourceSystemId "RMA_19153_CORN_2023" .

# RMA Yield Estimates (APH-based)
:rma_est_polk_2023 a arden-fin:ModeledEstimate ;
  arden-fin:wasGeneratedByModel :rma_apt_model ;
  prov:generatedAtTime "2023-03-15T00:00:00Z"^^xsd:dateTime ;
  sosa:resultTime "2023-03-15T00:00:00Z"^^xsd:dateTime ;
  sosa:hasFeatureOfInterest :county_area_19153 ;
  sosa:observedProperty :crop_corn ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "195.5"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] ;
  rdfs:label "RMA APH Yield Estimate - Polk County Corn 2023"@en ;
  arden:sourceSystemId "RMA_EST_19153_2023" .

:rma_est_story_2023 a arden-fin:ModeledEstimate ;
  arden-fin:wasGeneratedByModel :rma_apt_model ;
  prov:generatedAtTime "2023-03-15T00:00:00Z"^^xsd:dateTime ;
  sosa:resultTime "2023-03-15T00:00:00Z"^^xsd:dateTime ;
  sosa:hasFeatureOfInterest :county_area_19169 ;
  sosa:observedProperty :crop_corn ;
  sosa:hasResult [
    a qudt:QuantityValue ;
    qudt:numericValue "192.8"^^xsd:decimal ;
    qudt:unit unit:BushelPerAcre
  ] ;
  rdfs:label "RMA APH Yield Estimate - Story County Corn 2023"@en ;
  arden:sourceSystemId "RMA_EST_19169_2023" .

