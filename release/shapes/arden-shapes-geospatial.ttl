@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix arden: <https://arden.ag/ont/core#> .
@prefix arden-geo: <https://arden.ag/ont/geo#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Farm Parcel geospatial constraints
arden:FarmParcelGeoConstraints a sh:NodeShape ;
  sh:targetClass arden:FarmParcel ;

  # Must have valid geometry
  sh:property [
    sh:path geosparql:hasGeometry ;
    sh:class geosparql:Geometry ;
    sh:minCount 1 ;
    sh:message "Farm parcel must have geometry"
  ] ;

  # Geometry must have valid WKT or GeoJSON
  sh:sparql [
    sh:message "Geometry must have valid WKT literal" ;
    sh:select """
      SELECT $this
      WHERE {
        $this geosparql:hasGeometry ?geom .
        ?geom geosparql:asWKT ?wkt .
        FILTER (!REGEX(STR(?wkt), "^(POINT|LINESTRING|POLYGON|MULTIPOINT|MULTILINESTRING|MULTIPOLYGON|GEOMETRYCOLLECTION)"))
      }
    """
  ] ;

  # US agricultural regions: approximate bounds (continental US)
  sh:sparql [
    sh:message "Farm parcel coordinates outside continental US bounds" ;
    sh:select """
      SELECT $this
      WHERE {
        $this geosparql:hasGeometry ?geom .
        ?geom geosparql:asWKT ?wkt .
        # Simple regex check for longitude/latitude in WKT
        FILTER (
          REGEX(STR(?wkt), "[-]?[0-9]+\\.[0-9]+") &&
          (
            REGEX(STR(?wkt), "[-]?(1[3-9][0-9]|[2-9][0-9][0-9])\\.[0-9]+") ||  # longitude > -130 or < -60
            REGEX(STR(?wkt), "[6-9][0-9]\\.[0-9]+") ||  # latitude > 60
            REGEX(STR(?wkt), "[1-2][0-9]\\.[0-9]+")     # latitude < 20
          )
        )
      }
    """
  ] ;

  # Parcel area should be reasonable for agricultural operations
  sh:sparql [
    sh:message "Farm parcel area outside typical range (0.1 - 10,000 acres)" ;
    sh:select """
      SELECT $this
      WHERE {
        $this <https://example.org/areaAcres> ?acres .
        FILTER (?acres < 0.1 || ?acres > 10000)
      }
    """
  ] .

# County-Parcel consistency
arden:CountyParcelConsistency a sh:NodeShape ;
  sh:targetClass arden:FarmParcel ;

  # Parcel geometry should be within referenced county bounds
  # County containment check (requires GeoSPARQL functions)
  sh:sparql [
    sh:message "Parcel geometry must be within its county polygon" ;
    sh:select """
      SELECT $this WHERE {
        $this geosparql:hasGeometry ?pg .
        $this arden:locatedInCounty ?county .
        ?county geosparql:hasGeometry ?cg .
        FILTER ( !geof:sfWithin(?pg, ?cg) )
      }
    """
  ] .

# WKT Literal Sanity Checks
arden:GeometryWKTConstraints a sh:NodeShape ;
  sh:targetClass geosparql:Geometry ;

  # Must have WKT with correct datatype
  sh:property [
    sh:path geosparql:asWKT ;
    sh:datatype geosparql:wktLiteral ;
    sh:minCount 1 ;
    sh:message "Geometry must have WKT literal with geosparql:wktLiteral datatype"
  ] ;

  # WKT content validation
  sh:sparql [
    sh:message "Geometry WKT looks empty or malformed" ;
    sh:select """
      SELECT $this WHERE {
        $this geosparql:asWKT ?wkt .
        FILTER (STRLEN(STR(?wkt)) < 20)
      }
    """
  ] ;

  # Explicit CRS requirement (WGS84 assumed if none)
  sh:sparql [
    sh:message "Geometry should have explicit SRID for clarity" ;
    sh:select """
      SELECT $this WHERE {
        $this geosparql:asWKT ?wkt .
        FILTER (!REGEX(STR(?wkt), "^SRID=[0-9]+"))
      }
    """
  ] .