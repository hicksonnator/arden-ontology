@prefix arden-measure: <https://arden.ag/ont/measure#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .

<https://arden.ag/ont/measure>
  a owl:Ontology ; rdfs:label "Arden Measure Patterns"@en ; owl:versionInfo "v1.1" .

# Pattern: Use qudt:QuantityValue for all numeric results
arden-measure:quantityValue rdfs:subPropertyOf qudt:quantityValue .