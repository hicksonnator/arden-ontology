@prefix arden:     <https://arden.ag/ont/core#> .
@prefix arden-fin: <https://arden.ag/ont/fin#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .

<https://arden.ag/ont/fin>
  a owl:Ontology ; rdfs:label "Arden Finance"@en ; owl:versionInfo "v1.1" .

arden-fin:AgriculturalLoan a owl:Class ;
  rdfs:label "Agricultural loan"@en ;
  rdfs:comment "Loan extended to a farm operation; FIBO aligned in bridge layer."@en .

arden-fin:InsurancePolicy a owl:Class ;
  rdfs:label "Insurance policy"@en .

arden-fin:InsuranceClaim a owl:Class ;
  rdfs:label "Insurance claim"@en .

arden-fin:PreventedPlantingEvent a owl:Class ;
  rdfs:label "Prevented planting event"@en ;
  rdfs:comment "Area not planted due to covered cause; RMA SoB aligned."@en .

### Modeled estimates (RMA QuickEstimator, risk engines, etc.)
arden-fin:EstimationModel a owl:Class ;
  rdfs:label "Estimation model"@en ;
  rdfs:subClassOf prov:Activity .

arden-fin:ModeledEstimate a owl:Class ;
  rdfs:label "Modeled estimate"@en ;
  rdfs:subClassOf sosa:Observation , prov:Entity ;
  rdfs:comment "An estimate produced by a model; carries provenance and time."@en .

arden-fin:wasGeneratedByModel a owl:ObjectProperty ;
  rdfs:domain arden-fin:ModeledEstimate ;
  rdfs:range  arden-fin:EstimationModel ;
  rdfs:subPropertyOf prov:wasGeneratedBy ;
  rdfs:label "was generated by model"@en .