@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix arden-ag: <https://arden.ag/ont/ag#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

arden-ag:YieldObservationShape a sh:NodeShape ;
  sh:targetClass arden-ag:YieldObservation ;
  sh:property [
    sh:path sosa:hasResult ; sh:minCount 1 ; sh:class qudt:QuantityValue
  ] ;
  sh:property [
    sh:path sosa:resultTime ; sh:minCount 1 ; sh:datatype xsd:dateTime
  ] .