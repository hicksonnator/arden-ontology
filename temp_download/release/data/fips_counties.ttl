    a geosparql:Geometry ;
    geosparql:asWKT "SRID=4326;POLYGON((-91.8234 41.4623, -91.2934 41.4623, -91.2934 41.8456, -91.8234 41.8456, -91.8234 41.4623))"^^geosparql:wktLiteral
  ] ;
  <https://example.org/areaSquareMiles> "614.3"^^xsd:decimal ;
  <https://example.org/countySeat> "Iowa City"@en ;
  <https://example.org/ruralUrbanCode> "2"@en ;  # Micropolitan area
  <https://example.org/universityCampus> "University of Iowa"@en .

