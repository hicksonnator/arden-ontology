@prefix : <https://arden.ag/data/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# FIPS County Reference Data - Iowa
# Source: US Census Bureau FIPS codes - Public Domain

# FIPS Code Scheme
<https://arden.ag/codes/fips-counties> a skos:ConceptScheme ;
  skos:prefLabel "FIPS County Codes"@en ;
  dct:source <https://www.census.gov/library/reference/code-lists/ansi.html> ;
  dct:publisher "US Census Bureau"@en ;
  skos:definition "Federal Information Processing Standards (FIPS) county codes"@en .

# Iowa State
:state_19 a skos:Concept ;
  skos:inScheme <https://arden.ag/codes/fips-states> ;
  skos:notation "19" ;
  skos:prefLabel "Iowa"@en ;
  skos:altLabel "IA"@en .

# Polk County, IA (Des Moines metro area)
:fips_19153 a skos:Concept ;
  skos:inScheme <https://arden.ag/codes/fips-counties> ;
  skos:notation "19153" ;
  skos:prefLabel "Polk County, IA"@en ;
  skos:altLabel "POLK"@en ;
  dct:isPartOf :state_19 ;
  geosparql:hasGeometry [
    a geosparql:Geometry ;
    geosparql:asWKT "SRID=4326;POLYGON((-93.8936 41.3854, -93.3145 41.3854, -93.3145 41.7847, -93.8936 41.7847, -93.8936 41.3854))"^^geosparql:wktLiteral
  ] ;
  <https://example.org/areaSquareMiles> "592.2"^^xsd:decimal ;
  <https://example.org/countySeat> "Des Moines"@en ;
  <https://example.org/ruralUrbanCode> "1"@en ;  # Metropolitan county
  <https://example.org/metropolitanArea> "Des Moines-West Des Moines, IA"@en .

# Story County, IA (Ames - Iowa State University)
:fips_19169 a skos:Concept ;
  skos:inScheme <https://arden.ag/codes/fips-counties> ;
  skos:notation "19169" ;
  skos:prefLabel "Story County, IA"@en ;
  skos:altLabel "STORY"@en ;
  dct:isPartOf :state_19 ;
  geosparql:hasGeometry [
    a geosparql:Geometry ;
    geosparql:asWKT "SRID=4326;POLYGON((-93.8428 42.0334, -93.3428 42.0334, -93.3428 42.3945, -93.8428 42.3945, -93.8428 42.0334))"^^geosparql:wktLiteral
  ] ;
  <https://example.org/areaSquareMiles> "572.9"^^xsd:decimal ;
  <https://example.org/countySeat> "Nevada"@en ;
  <https://example.org/ruralUrbanCode> "3"@en ;  # Adjacent to metropolitan area
  <https://example.org/universityCampus> "Iowa State University"@en .

