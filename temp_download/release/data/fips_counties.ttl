# Sioux County, IA (livestock intensive)
:fips_19167 a skos:Concept ;
  skos:inScheme <https://arden.ag/codes/fips-counties> ;
  skos:notation "19167" ;
  skos:prefLabel "Sioux County, IA"@en ;
  skos:altLabel "SIOUX"@en ;
  dct:isPartOf :state_19 ;
  geosparql:hasGeometry [
    a geosparql:Geometry ;
    geosparql:asWKT "SRID=4326;POLYGON((-96.6378 43.0623, -96.1378 43.0623, -96.1378 43.4234, -96.6378 43.4234, -96.6378 43.0623))"^^geosparql:wktLiteral
  ] ;
  <https://example.org/areaSquareMiles> "768.4"^^xsd:decimal ;
  <https://example.org/countySeat> "Orange City"@en ;
  <https://example.org/ruralUrbanCode> "7"@en ;  # Nonmetropolitan, urban population < 2,500
  <https://example.org/primaryIndustry> "Livestock"@en ;
  <https://example.org/specialization> "Hog Production"@en .

# Geographic Classifications for Analysis
:iowa_counties a skos:Collection ;
  skos:prefLabel "Iowa Counties"@en ;
  skos:member :fips_19153, :fips_19169, :fips_19103, :fips_19113, :fips_19079, :fips_19167 .

:metro_counties a skos:Collection ;
  skos:prefLabel "Metropolitan Counties"@en ;
  skos:member :fips_19153, :fips_19113 .

:university_counties a skos:Collection ;
  skos:prefLabel "University Counties"@en ;
  skos:member :fips_19169, :fips_19103 .

:rural_ag_counties a skos:Collection ;
  skos:prefLabel "Rural Agricultural Counties"@en ;
  skos:member :fips_19079, :fips_19167 .