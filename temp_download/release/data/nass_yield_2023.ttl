# County Agricultural Areas (representative parcels)
:county_area_19153 a arden:FarmParcel ;
  arden:locatedInCounty :fips_19153 ;
  rdfs:label "Polk County Agricultural Area"@en .

:county_area_19169 a arden:FarmParcel ;
  arden:locatedInCounty :fips_19169 ;
  rdfs:label "Story County Agricultural Area"@en .

:county_area_19113 a arden:FarmParcel ;
  arden:locatedInCounty :fips_19113 ;
  rdfs:label "Linn County Agricultural Area"@en .

:county_area_19103 a arden:FarmParcel ;
  arden:locatedInCounty :fips_19103 ;
  rdfs:label "Johnson County Agricultural Area"@en .

